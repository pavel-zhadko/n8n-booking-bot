    {
      "parameters": {
        "jsCode": "const daysAhead = 7;\nconst timeZone = 'Europe/Moscow';\nconst trigger = $('Telegram Trigger').first().json;\nconst chatId = trigger.message?.chat?.id ?? trigger.callback_query?.message?.chat?.id;\n\nconst buttons = [];\nfor (let i = 1; i <= daysAhead; i++) {\n  const d = new Date();\n  d.setDate(d.getDate() + i);\n  const off = d.getTimezoneOffset() * 60000;\n  const iso = new Date(d.getTime() - off).toISOString().split('T')[0];\n  const label = d.toLocaleDateString('ru-RU', { timeZone, weekday: 'short', day: 'numeric', month: 'short' });\n  buttons.push({ text: label, callback_data: `day_${iso}` });\n}\n\nconst rows = [];\nwhile (buttons.length) rows.push(buttons.splice(0, 2));\n\nreturn [{ json: { chatId, text: '📅 Выберите дату:', reply_markup: { inline_keyboard: rows } } }];\n"
      },
