        "jsCode": "const msg = $input.first().json.message;\nconst c = msg.contact;\n\nreturn [{\n  json: {\n    name: c.first_name || msg.from.first_name || 'Клиент',\n    phone: String(c.phone_number).replace(/\\D/g, ''),\n    date: new Date().toLocaleString('ru-RU', { timeZone: 'Europe/Moscow' }),\n    chatId: msg.chat.id,\n    error: false,\n    isCommand: false\n  }\n}];\n\n\n\n\n"
