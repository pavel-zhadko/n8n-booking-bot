    {
      "parameters": {
        "jsCode": "// Получаем данные из кнопки\nconst data = $input.first().json.callback_query.data;\nconst message = $input.first().json.callback_query.message;\nconst user = $input.first().json.callback_query.from;\n\n// Разделяем действие и данные\nconst parts = data.split('_');\nconst action = parts[0];\nif (action === \"day\") {\n  return [{\n    json: {\n      type: 'day_select',\n      date: parts[1],\n      chatId: message.chat.id,\n      messageId: message.message_id,\n      callbackQueryId: $input.first().json.callback_query.id\n    }\n  }];\n}\n\n// ✨ ОБРАБОТКА БРОНИРОВАНИЯ (book_2026-01-25_14:00)\nif (action === \"book\") {\n  const date = parts[1];      // \"2026-01-25\"\n  const time = parts[2];      // \"11:00\"\n  \n  const userName = user.first_name || 'Клиент';\n  const userId = user.id;\n  const userHandle = user.username ? `@${user.username}` : '';\n\n  // Простой расчет: парсим часы и добавляем 1\n  const [hours, minutes] = time.split(':');\n  const startHour = parseInt(hours);\n  const endHour = startHour + 1;\n  \n  // Форматируем БЕЗ timezone (Google Calendar node сам добавит его из настроек)\n  const startDateTime = `${date}T${String(startHour).padStart(2, '0')}:${minutes}:00`;\n  const endDateTime = `${date}T${String(endHour).padStart(2, '0')}:${minutes}:00`;\n\n  return [{\n    json: {\n      type: 'booking',\n      start: startDateTime,     // 2026-01-25T11:00:00+03:00\n      end: endDateTime,         // 2026-01-25T12:00:00+03:00\n      datePretty: date,\n      timePretty: time,\n      userName: userName,\n      userId: userId,\n      userHandle: userHandle,\n      userPhone: userHandle || `ID: ${userId}`,\n      callbackQueryId: $input.first().json.callback_query.id,\n      chatId: message.chat.id,\n      messageId: message.message_id\n    }\n  }];\n}\n\n// ОБРАБОТКА СТАТУСОВ (accept/reject/work)\nconst phoneNumber = parts[1];\nlet newStatus = \"\";\nlet replyText = \"\";\n\nif (action === \"accept\") {\n  newStatus = \"Обработана\";\n  replyText = \"✅ Вы приняли заявку от: \" + phoneNumber;\n} else if (action === \"reject\") {\n  newStatus = \"Отклонена\";\n  replyText = \"❌ Вы отклонили заявку от: \" + phoneNumber;\n} else if (action === \"work\") {\n  newStatus = \"В работе\";\n  replyText = \"⏳ Заявка от \" + phoneNumber + \" взята в работу\";\n}\n\nreturn [{\n  json: {\n    type: 'status_update',\n    phoneNumber: phoneNumber,\n    newStatus: newStatus,\n    replyText: replyText,\n    callbackQueryId: $input.first().json.callback_query.id,\n    chatId: message.chat.id,\n    messageId: message.message_id\n  }\n}];\n\n"
      },
