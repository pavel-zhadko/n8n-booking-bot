    {
      "parameters": {
        "jsCode": "const timeZone = 'Europe/Moscow';\nconst workStart = 10;\nconst workEnd = 18;\n\nconst sel = $('Code in JavaScript2').first().json;\nconst dateIso = sel.date;\nconst chatId = sel.chatId;\n\nconst busySlots = $input.all()\n  .filter(i => i.json.start && i.json.start.dateTime)\n  .map(i => {\n    const d = new Date(new Date(i.json.start.dateTime).toLocaleString('en-US', { timeZone }));\n    return `${String(d.getHours()).padStart(2, '0')}:00`;\n  });\n\nconst allSlots = [];\nfor (let h = workStart; h < workEnd; h++) {\n  allSlots.push(`${String(h).padStart(2, '0')}:00`);\n}\nconst freeSlots = allSlots.filter(s => !busySlots.includes(s));\n\nconst buttons = freeSlots.map(s => ({ text: `🕐 ${s}`, callback_data: `book_${dateIso}_${s}` }));\nconst rows = [];\nwhile (buttons.length) rows.push(buttons.splice(0, 3));\n\nconst pretty = DateTime.fromISO(dateIso).setLocale('ru').toFormat('d MMMM');\n\nreturn [{\n  json: {\n    chatId,\n    text: freeSlots.length > 0\n      ? `📅 ${pretty}\\nВыберите свободное время:`\n      : `❌ На ${pretty} свободного времени нет.`,\n    reply_markup: { inline_keyboard: rows }\n  }\n}];"
      },
