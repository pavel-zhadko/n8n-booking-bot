    {
      "parameters": {
        "jsCode": "// Получаем текст сообщения и ID чата\nconst text = $input.first().json.message.text;\nconst chatId = $input.first().json.message.chat.id;\nconst userName = $input.first().json.message.from.first_name || 'Клиент';\nconst userId = $input.first().json.message.from.id;\n\n// НОВАЯ ПРОВЕРКА: Если это команда (начинается с \"/\"), обрабатываем\nif (text && text.startsWith('/')) {\n  // Команда /start — отправляем инструкцию\n  if (text === '/start') {\n    return [{\n      json: {\n        isCommand: true,  // boolean без кавычек\n        commandType: 'start',\n        commandResponse: \"👋 Здравствуйте!\\n\\n📝 Чтобы оставить заявку, отправьте сообщение в формате:\\n\\n<b>Имя Телефон</b>\\n\\n✅ Пример:\\nИван 89991234567\\n\\n📅 Для записи на услугу отправьте:\\n/запись\",\n        chatId: chatId,\n        error: false  // boolean без кавычек\n      }\n    }];\n  }\n\n  // ✨ НОВАЯ КОМАНДА: /запись\n  if (text === '/запись' || text === '/zapis') {\n    return [{\n      json: {\n        isCommand: true,  // boolean без кавычек\n        commandType: 'booking',\n        userName: userName,\n        userId: userId,\n        chatId: chatId,\n        error: false  // boolean без кавычек\n      }\n    }];\n  }\n\n  // Для других команд просто игнорируем\n  return [{\n    json: {\n      isCommand: true,  // boolean без кавычек\n      commandType: 'unknown',\n      commandResponse: \"❓ Неизвестная команда.\\n\\nДоступные команды:\\n/start - инструкция\\n/запись - записаться на услугу\\n\\nИли отправьте заявку в формате:\\nИмя Телефон\",\n      chatId: chatId,\n      error: false  // boolean без кавычек\n    }\n  }];\n}\n\n// Проверка 1: Есть ли вообще текст?\nif (!text || text.trim() === '') {\n  return [{\n    json: {\n      error: true,  // boolean без кавычек\n      errorMessage: \"❌ Вы отправили пустое сообщение!\\n\\n📝 Отправьте заявку в формате:\\nИмя Телефон\\n\\n✅ Пример:\\nИван 89991234567\",\n      chatId: chatId\n    }\n  }];\n}\n\n// Разделяем по пробелу\nconst parts = text.trim().split(/\\s+/);\n\n// Проверка 2: Есть ли минимум 2 части (имя и телефон)?\nif (parts.length < 2) {\n  return [{\n    json: {\n      error: true,  // boolean без кавычек\n      errorMessage: \"❌ Не хватает данных!\\n\\n🔴 Что не так:\\nУказано только одно слово. Нужно указать ИМЯ и ТЕЛЕФОН через пробел.\\n\\n📝 Правильный формат:\\nИмя Телефон\\n\\n✅ Примеры:\\nИван 89991234567\\nМария +7-926-123-45-67\",\n      chatId: chatId\n    }\n  }];\n}\n\nconst name = parts[0];\nconst phoneRaw = parts.slice(1).join(''); // объединяем всё после имени\nconst phone = phoneRaw.replace(/[\\s\\-\\(\\)]/g, ''); // убираем пробелы, дефисы, скобки\n\n// Проверка 3: Похоже ли это на номер телефона?\nconst phoneRegex = /^(\\+?7|8)[\\s\\-]?\\d{3}[\\s\\-]?\\d{3}[\\s\\-]?\\d{2}[\\s\\-]?\\d{2}$/;\n\nif (!phoneRegex.test(phoneRaw)) {\n  let hint = \"\";\n\n  if (phone.length < 10) {\n    hint = `\\n\\n🔴 Что не так:\\nТелефон слишком короткий (${phone.length} цифр). Нужно 11 цифр.`;\n  } else if (phone.length > 11) {\n    hint = `\\n\\n🔴 Что не так:\\nТелефон слишком длинный (${phone.length} цифр). Нужно 11 цифр.`;\n  } else if (!/^\\d+$/.test(phone.replace(/^\\+/, ''))) {\n    hint = `\\n\\n🔴 Что не так:\\nВ номере есть недопустимые символы. Используйте только цифры, +, -, ( )`;\n  } else {\n    hint = `\\n\\n🔴 Что не так:\\nНомер не соответствует российскому формату.`;\n  }\n\n  return [{\n    json: {\n      error: true,  // boolean без кавычек\n      errorMessage: `❌ Неверный формат телефона!${hint}\\n\\n📝 Допустимые форматы:\\n• 89991234567\\n• +79991234567\\n• 8-999-123-45-67\\n• 8 (999) 123-45-67\\n\\n✏️ Попробуйте ещё раз:\\n${name} <исправленный номер>`,\n      chatId: chatId\n    }\n  }];\n}\n\n// Всё ок — нормализуем номер к формату 79991234567\nlet normalizedPhone = phone.replace(/[^\\d]/g, ''); // только цифры\nif (normalizedPhone.startsWith('8')) {\n  normalizedPhone = '7' + normalizedPhone.slice(1);\n}\nif (!normalizedPhone.startsWith('7')) {\n  normalizedPhone = '7' + normalizedPhone;\n}\n\nconst date = new Date().toLocaleString('ru-RU', { timeZone: 'Europe/Moscow' });\n\nreturn [{\n  json: {\n    error: false,      // boolean без кавычек\n    isCommand: false,  // boolean без кавычек\n    name: name,\n    phone: normalizedPhone,\n    date: date,\n    chatId: chatId\n  }\n}];\n\n\n\n\n\n"
      },
